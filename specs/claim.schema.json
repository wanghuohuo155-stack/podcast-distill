{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "podcast-distill claim schema",
  "type": "object",
  "required": ["claim_id", "skill_slug", "kind", "title", "source_chapter", "source_quote", "summary"],
  "properties": {
    "claim_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "skill_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "kind": { "enum": ["insight", "action", "quote", "case", "principle"] },
    "title": { "type": "string", "minLength": 1 },
    "source_chapter": { "type": "string", "minLength": 1 },
    "source_quote": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "when": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "if": { "properties": { "kind": { "const": "action" } } },
  "then": { "required": ["when"] }
}
